 
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>JARVIS 2.0</title>
<style>
*{box-sizing:border-box}
body{
margin:0;background:#020712;color:#68e5ff;
font-family:Arial,sans-serif;min-height:100vh;
display:flex;justify-content:center;align-items:center;
}
.app{width:100%;max-width:500px;padding:20px;text-align:center}
h1{letter-spacing:7px;text-shadow:0 0 20px #00cfff}
.status{color:#91aabd;font-size:13px}
.core{
width:180px;height:180px;border-radius:50%;
border:2px solid #00d9ff;margin:25px auto;
display:flex;align-items:center;justify-content:center;
box-shadow:0 0 30px #00cfff,inset 0 0 30px #00cfff;
animation:pulse 2s infinite
}
.core span{font-size:40px}
@keyframes pulse{50%{box-shadow:0 0 55px #00cfff,inset 0 0 45px #00cfff}}
button{
background:#071a2b;border:1px solid #00cfff;color:#68e5ff;
padding:14px;border-radius:12px;margin:6px;font-size:15px
}
input{
width:100%;padding:15px;background:#071a2b;color:white;
border:1px solid #00cfff;border-radius:10px;font-size:16px
}
.chat{
height:210px;overflow-y:auto;border:1px solid #164d6b;
border-radius:12px;padding:12px;text-align:left;
margin:20px 0;background:#04101c
}
.msg{margin:10px 0;line-height:1.5;overflow-wrap:anywhere}
.user{color:white}
.bot{color:#68e5ff}
.controls{display:flex;gap:5px}
.controls input{flex:1;min-width:0}
.controls button{margin:0}
.small{font-size:12px;color:#91aabd}
</style>
</head>
<body>
<div class="app">
<h1>J.A.R.V.I.S.</h1>
<div class="status" id="status">SYSTEM ONLINE</div>
<div class="core"><span>◉</span></div>

<button onclick="listen()">🎙 SPEAK</button>
<button onclick="stopListening()">STOP</button>

<div class="chat" id="chat">
<div class="msg bot">JARVIS: Systems online. Awaiting commands.</div>
</div>

<div class="controls">
<input id="command" placeholder="Ask JARVIS..." autocomplete="off">
<button onclick="send()">SEND</button>
</div>

<p class="small">Voice • Commands • Time • Apps</p>
</div>

<script>
let recognition;

function addMsg(who,text){
let chat=document.getElementById("chat");
let div=document.createElement("div");
div.className="msg "+who;
div.textContent=(who==="user"?"YOU: ":"JARVIS: ")+text;
chat.appendChild(div);
chat.scrollTop=chat.scrollHeight;
}

function speak(text){
addMsg("bot",text);
if("speechSynthesis" in window){
speechSynthesis.cancel();
let u=new SpeechSynthesisUtterance(text);
u.lang="en-IN";
speechSynthesis.speak(u);
}
}

function send(){
let box=document.getElementById("command");
let c=box.value.trim().toLowerCase();
if(!c)return;
addMsg("user",c);
box.value="";

if(c.includes("hello")||c.includes("hi jarvis")){
speak("Hello. JARVIS is ready.");
}
else if(c.includes("time")){
speak("The time is "+new Date().toLocaleTimeString());
}
else if(c.includes("date")){
speak("Today is "+new Date().toLocaleDateString());
}
else if(c.includes("battery")){
speak("Please check your phone status bar for battery level.");
}
else if(c.includes("open youtube")){
speak("Opening YouTube.");
window.open("https://youtube.com","_blank");
}
else if(c.includes("open google")){
speak("Opening Google.");
window.open("https://google.com","_blank");
}
else if(c.includes("open whatsapp")){
speak("Opening WhatsApp.");
window.open("https://whatsapp.com","_blank");
}
else if(c.includes("open instagram")){
speak("Opening Instagram.");
window.open("https://instagram.com","_blank");
}
else if(c.includes("open camera")){
speak("Opening camera website.");
window.open("https://camera.lol","_blank");
}
else if(c.includes("who are you")){
speak("I am JARVIS, your personal web assistant.");
}
else if(c.includes("your name")){
speak("My name is JARVIS.");
}
else if(c.includes("help")||c.includes("commands")){
speak("Try hello, time, date, battery, who are you, open YouTube, open Google, open WhatsApp or open Instagram.");
}
else if(c.includes("stop voice")||c==="stop"){
stopListening();
speak("Voice listening stopped.");
}
else{
speak("I do not have an AI brain connected yet. This feature will be upgraded.");
}
}

function listen(){
let R=window.SpeechRecognition||window.webkitSpeechRecognition;
if(!R){
speak("Speech recognition is not supported in this browser.");
return;
}
recognition=new R();
recognition.lang="en-IN";
recognition.continuous=false;
recognition.interimResults=false;
recognition.onstart=()=>{
document.getElementById("status").innerText="LISTENING...";
};
recognition.onresult=e=>{
document.getElementById("command").value=e.results[0][0].transcript;
send();
};
recognition.onerror=e=>{
document.getElementById("status").innerText="VOICE ERROR";
};
recognition.onend=()=>{
document.getElementById("status").innerText="SYSTEM ONLINE";
};
recognition.start();
}

function stopListening(){
if(recognition){
recognition.stop();
}
if("speechSynthesis" in window){
speechSynthesis.cancel();
}
document.getElementById("status").innerText="SYSTEM ONLINE";
}

document.getElementById("command").addEventListener("keydown",e=>{
if(e.key==="Enter")send();
});
</script>
</body>
</html>
